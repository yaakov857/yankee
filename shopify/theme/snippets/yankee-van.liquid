{%- comment -%}
  The animated delivery scene: van with the store name, moving road, parcels flying to the house, clouds and a map pin.
  Usage: {% render 'yankee-van', van_text: 'YANKEE' %}
{%- endcomment -%}
{%- assign van_text = van_text | default: 'YANKEE' -%}
<svg class="yk-scene" viewBox="0 0 480 320" role="img" aria-label="{{ van_text | escape }}">
  <rect width="480" height="320" fill="var(--yk-sky)"/>
  <circle class="yk-sun" cx="400" cy="68" r="28" fill="var(--yk-sun)"/>
  <g class="yk-c1"><ellipse cx="110" cy="66" rx="34" ry="13" fill="var(--yk-cloud)"/><ellipse cx="128" cy="56" rx="20" ry="13" fill="var(--yk-cloud)"/></g>
  <g class="yk-c2"><ellipse cx="280" cy="104" rx="26" ry="10" fill="var(--yk-cloud)"/><ellipse cx="294" cy="96" rx="15" ry="10" fill="var(--yk-cloud)"/></g>
  <path d="M0 232 Q120 192 240 226 T480 214 V320 H0Z" fill="var(--yk-hill)"/>
  <rect y="250" width="480" height="70" fill="var(--yk-road)"/>
  <line class="yk-dash" x1="0" y1="290" x2="480" y2="290" stroke="var(--yk-dash)" stroke-width="4" stroke-dasharray="22 18"/>
  <g>
    <rect x="40" y="170" width="100" height="80" fill="var(--yk-surface)" stroke="var(--yk-ink)" stroke-width="3"/>
    <path d="M28 176 L90 124 L152 176Z" fill="var(--yk-accent-2)"/>
    <rect x="78" y="205" width="24" height="45" fill="var(--yk-kraft)" stroke="var(--yk-ink)" stroke-width="2"/>
    <rect x="52" y="190" width="18" height="18" fill="var(--yk-sky)" stroke="var(--yk-ink)" stroke-width="2"/>
    <rect x="110" y="190" width="18" height="18" fill="var(--yk-sky)" stroke="var(--yk-ink)" stroke-width="2"/>
  </g>
  <g class="yk-pin"><path d="M90 84c-12 0-20 9-20 19 0 14 20 30 20 30s20-16 20-30c0-10-8-19-20-19z" fill="var(--yk-danger)"/><circle cx="90" cy="103" r="7" fill="var(--yk-surface)"/></g>
  <g class="yk-fly"><rect x="232" y="214" width="26" height="22" rx="2" fill="var(--yk-kraft)" stroke="var(--yk-ink)" stroke-width="1.5"/><rect x="243" y="214" width="4" height="22" fill="var(--yk-ink)" opacity=".25"/></g>
  <g class="yk-fly yk-p2"><rect x="232" y="214" width="26" height="22" rx="2" fill="var(--yk-kraft)" stroke="var(--yk-ink)" stroke-width="1.5"/><rect x="243" y="214" width="4" height="22" fill="var(--yk-ink)" opacity=".25"/></g>
  <g class="yk-van-in"><g class="yk-van">
    <rect x="290" y="190" width="132" height="68" rx="6" fill="var(--yk-accent)"/>
    <path d="M292 206 H266 L250 234 V258 H292Z" fill="var(--yk-accent-2)"/>
    <path d="M286 211 H269 L258 231 H286Z" fill="var(--yk-sky)"/>
    <rect x="300" y="200" width="30" height="24" rx="2" fill="var(--yk-kraft)"/>
    <rect x="313" y="200" width="4" height="24" fill="var(--yk-ink)" opacity=".25"/>
    <text x="374" y="234" text-anchor="middle" font-family="Secular One, Assistant, sans-serif" font-size="20" letter-spacing="1" direction="ltr" fill="var(--yk-accent-ink)">{{ van_text | escape }}</text>
    <g class="yk-wheel"><circle cx="280" cy="260" r="15" fill="var(--yk-ink)"/><circle cx="280" cy="260" r="6" fill="var(--yk-dash)"/><rect x="278" y="246" width="4" height="9" fill="var(--yk-dash)"/></g>
    <g class="yk-wheel"><circle cx="392" cy="260" r="15" fill="var(--yk-ink)"/><circle cx="392" cy="260" r="6" fill="var(--yk-dash)"/><rect x="390" y="246" width="4" height="9" fill="var(--yk-dash)"/></g>
  </g></g>
  <g class="yk-speed" stroke="var(--yk-ink)" stroke-width="3" stroke-linecap="round" opacity=".45"><line x1="432" y1="208" x2="458" y2="208"/><line x1="440" y1="232" x2="470" y2="232"/></g>
</svg>
