{%- comment -%}
  YANKEE animated home page header: headline, buttons, countdown to the daily cutoff, and the delivery van scene.
  Works right-to-left, on phones, in dark and light mode, and without animation for people who asked for less motion.
{%- endcomment -%}
{{ 'yankee.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Secular+One&family=Assistant:wght@400;600;700&display=swap">
{%- liquid
  assign dir = 'ltr'
  assign rtl_langs = 'he,ar,fa,ur'
  if rtl_langs contains request.locale.iso_code
    assign dir = 'rtl'
  endif
  assign s = section.settings
-%}
<div class="yk yk--{{ s.color_mode }}" dir="{{ dir }}">
  <div class="yk-hero is-intro">
    <div class="yk-wrap yk-hero__grid">
      <div class="yk-hero__copy">
        {%- if s.eyebrow != blank -%}<span class="yk-eyebrow">{{ s.eyebrow | escape }}</span>{%- endif -%}
        <h1>{{ s.heading | escape }}{% if s.heading_highlight != blank %} <span class="yk-hl">{{ s.heading_highlight | escape }}</span>{% endif %}</h1>
        {%- if s.text != blank -%}<p class="yk-hero__text">{{ s.text | escape }}</p>{%- endif -%}
        <div class="yk-cta">
          {%- if s.button1_label != blank and s.button1_link != blank -%}
            <a class="yk-btn yk-btn--primary" href="{{ s.button1_link }}">{{ s.button1_label | escape }}</a>
          {%- endif -%}
          {%- if s.button2_label != blank and s.button2_link != blank -%}
            <a class="yk-btn yk-btn--ghost" href="{{ s.button2_link }}">{{ s.button2_label | escape }}</a>
          {%- endif -%}
        </div>
        {%- if s.show_countdown -%}
          <div class="yk-cutoff" data-yk-countdown
            data-cutoff="{{ s.cutoff_hour }}" data-cutoff-friday="{{ s.cutoff_friday }}"
            data-live="{{ s.countdown_live | escape }}"
            data-closed-tomorrow="{{ s.closed_tomorrow | escape }}"
            data-closed-sunday="{{ s.closed_sunday | escape }}">
            <span class="yk-dot"></span> {{ s.closed_tomorrow | escape }}
          </div>
        {%- endif -%}
        {%- if s.free_text != blank -%}<p class="yk-free">{{ s.free_text }}</p>{%- endif -%}
      </div>
      <div class="yk-hero__art">{% render 'yankee-van', van_text: s.van_text %}</div>
    </div>
  </div>
</div>
<script src="{{ 'yankee.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "YANKEE – פתיח מונפש",
  "tag": "section",
  "class": "yk-section",
  "settings": [
    {
      "type": "select", "id": "color_mode", "label": "מצב צבעים", "default": "auto",
      "options": [
        { "value": "auto", "label": "לפי המכשיר (כהה או בהיר)" },
        { "value": "light", "label": "תמיד בהיר" },
        { "value": "dark", "label": "תמיד כהה" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "שורה קטנה מעל הכותרת", "default": "משלוחים עד הבית, ראשון עד שישי" },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "כל מה שצריך לבית," },
    { "type": "text", "id": "heading_highlight", "label": "סוף הכותרת (עם קו מודגש)", "default": "עד הדלת" },
    { "type": "textarea", "id": "text", "label": "טקסט", "default": "מוצרים לבית, אלקטרוניקה, טיפוח, ילדים וספורט. מזמינים עכשיו, בוחרים חלון זמן, והשליח מגיע." },
    { "type": "header", "content": "כפתורים" },
    { "type": "text", "id": "button1_label", "label": "כפתור ראשי", "default": "לקטלוג המלא" },
    { "type": "url", "id": "button1_link", "label": "קישור לכפתור הראשי", "default": "/collections/all" },
    { "type": "text", "id": "button2_label", "label": "כפתור שני", "default": "מבצעי השבוע" },
    { "type": "url", "id": "button2_link", "label": "קישור לכפתור השני", "info": "בחרו את הקולקציה \"מבצעי השבוע\"" },
    { "type": "header", "content": "שעון ספירה לאחור" },
    { "type": "checkbox", "id": "show_countdown", "label": "להציג שעון עד שעת הסגירה", "default": true },
    { "type": "range", "id": "cutoff_hour", "label": "שעת סגירה בימים א'-ה'", "min": 8, "max": 22, "step": 1, "default": 14 },
    { "type": "range", "id": "cutoff_friday", "label": "שעת סגירה ביום שישי", "min": 8, "max": 16, "step": 1, "default": 11 },
    { "type": "text", "id": "countdown_live", "label": "טקסט לפני הסגירה", "info": "{time} יוחלף בשעון", "default": "הזמינו בתוך {time} וההזמנה יוצאת היום (אזור המרכז)" },
    { "type": "text", "id": "closed_tomorrow", "label": "טקסט אחרי הסגירה", "default": "הזמנות מעכשיו יוצאות מחר בבוקר" },
    { "type": "text", "id": "closed_sunday", "label": "טקסט בשישי אחרי הסגירה ובשבת", "default": "הזמנות מעכשיו יוצאות ביום ראשון בבוקר" },
    { "type": "header", "content": "עוד" },
    { "type": "inline_richtext", "id": "free_text", "label": "שורת משלוח חינם", "default": "משלוח חינם בהזמנה מעל <b>₪299</b>" },
    { "type": "text", "id": "van_text", "label": "הכיתוב על הוואן", "default": "YANKEE" }
  ],
  "presets": [ { "name": "YANKEE – פתיח מונפש" } ]
}
{% endschema %}
