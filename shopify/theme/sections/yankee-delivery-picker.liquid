{%- comment -%}
  YANKEE delivery day and time picker for the cart page.
  The choice is saved as cart attributes, so it appears at checkout and on every order in the admin.
  No Saturday; Friday shows only the first time window(s). Checkout is blocked until a choice is made.
{%- endcomment -%}
{{ 'yankee.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign dir = 'ltr'
  assign rtl_langs = 'he,ar,fa,ur'
  if rtl_langs contains request.locale.iso_code
    assign dir = 'rtl'
  endif
  assign s = section.settings
  assign date_key = s.attr_date | default: 'תאריך משלוח'
  assign slot_key = s.attr_slot | default: 'חלון משלוח'
  assign slot_list = s.slots | newline_to_br | split: '<br />'
-%}
<div class="yk yk--{{ s.color_mode }} yk-delivery" dir="{{ dir }}">
  <div class="yk-wrap">
    <div class="yk-delivery__box" data-yk-delivery
      data-days="{{ s.days }}" data-start="{{ s.start }}" data-friday-slots="{{ s.friday_slots }}"
      data-required="{{ s.required }}"
      data-slots="{{ slot_list | json | escape }}"
      data-attr-date="{{ date_key | escape }}" data-attr-slot="{{ slot_key | escape }}"
      data-current-date="{{ cart.attributes[date_key] | escape }}" data-current-slot="{{ cart.attributes[slot_key] | escape }}"
      data-text-pick-day="בחרו יום כדי לראות את השעות."
      data-text-saving="שומרים…"
      data-text-saved="נשמר: {choice}"
      data-text-save-error="לא הצלחנו לשמור את הבחירה. נסו לבחור שוב."
      data-text-required="{{ s.required_text | escape }}">
      <h2>{{ s.heading | escape }}</h2>
      <div class="yk-days" data-yk-days role="group" aria-label="יום משלוח"></div>
      <div class="yk-slots" data-yk-slots role="group" aria-label="חלון שעות"></div>
      <p data-yk-msg class="yk-hint" aria-live="polite"></p>
      {%- if s.hint != blank -%}<p class="yk-hint">{{ s.hint | escape }}</p>{%- endif -%}
      <input type="hidden" form="cart" name="attributes[{{ date_key | escape }}]" value="{{ cart.attributes[date_key] | escape }}" data-yk-hidden-date>
      <input type="hidden" form="cart" name="attributes[{{ slot_key | escape }}]" value="{{ cart.attributes[slot_key] | escape }}" data-yk-hidden-slot>
      <noscript><p class="yk-err">כדי לבחור יום ושעה למשלוח צריך להפעיל JavaScript בדפדפן.</p></noscript>
    </div>
  </div>
</div>
<script src="{{ 'yankee.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "YANKEE – יום ושעת משלוח",
  "tag": "section",
  "class": "yk-section",
  "enabled_on": { "templates": ["cart"] },
  "settings": [
    {
      "type": "select", "id": "color_mode", "label": "מצב צבעים", "default": "auto",
      "options": [
        { "value": "auto", "label": "לפי המכשיר (כהה או בהיר)" },
        { "value": "light", "label": "תמיד בהיר" },
        { "value": "dark", "label": "תמיד כהה" }
      ]
    },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "מתי נוח לקבל?" },
    { "type": "textarea", "id": "slots", "label": "חלונות משלוח (שורה לכל חלון)", "default": "08:00–12:00\n12:00–16:00\n16:00–20:00" },
    { "type": "range", "id": "friday_slots", "label": "כמה חלונות ביום שישי (מהראשון)", "min": 1, "max": 3, "step": 1, "default": 1 },
    { "type": "range", "id": "days", "label": "כמה ימים להציג", "min": 3, "max": 14, "step": 1, "default": 6 },
    { "type": "range", "id": "start", "label": "היום הראשון: בעוד כמה ימים (0 = היום)", "min": 0, "max": 3, "step": 1, "default": 1 },
    { "type": "checkbox", "id": "required", "label": "חובה לבחור לפני התשלום", "default": true },
    { "type": "text", "id": "required_text", "label": "הודעה כשלא בחרו", "default": "יש לבחור יום ושעה למשלוח לפני המעבר לתשלום." },
    { "type": "text", "id": "hint", "label": "הערה מתחת לבחירה", "default": "אין משלוחים בשבת. ביום שישי רק בבוקר." },
    { "type": "header", "content": "שמות השדות בהזמנה" },
    { "type": "text", "id": "attr_date", "label": "שם שדה התאריך", "default": "תאריך משלוח" },
    { "type": "text", "id": "attr_slot", "label": "שם שדה השעות", "default": "חלון משלוח" }
  ],
  "presets": [ { "name": "YANKEE – יום ושעת משלוח" } ]
}
{% endschema %}
